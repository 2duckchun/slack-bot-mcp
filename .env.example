# https://api.slack.com/apps 에서 앱 생성 후 발급
# README의 매니페스트에 툴셋별로 필요한 스코프가 정리돼 있습니다.

# 봇 토큰 (필수) — 이 서버가 받는 유일한 자격 증명
SLACK_BOT_TOKEN=xoxb-

# --- 이하 선택 ---
# 등록할 툴셋. 기본값: core,messaging,conversations,users,reactions,files,workspace
# 전체를 켜려면 all
SLACK_MCP_TOOLSETS=

# 쓰기 툴을 전부 숨긴다
SLACK_MCP_READ_ONLY=false

# 쓰기를 이 채널들로만 제한 (ID 또는 #이름, 쉼표 구분)
SLACK_MCP_ALLOWED_CHANNELS=

# 거부/허용할 메서드 패턴 (쉼표 구분, * 와일드카드)
SLACK_MCP_DENIED_METHODS=
SLACK_MCP_ALLOWED_METHODS=

# 툴 결과 JSON 최대 길이
SLACK_MCP_MAX_RESPONSE_CHARS=40000

# 오르그 전체 설치일 때의 팀 ID
SLACK_MCP_TEAM_ID=
